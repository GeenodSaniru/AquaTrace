rules_version = '2';

/**
 * AquaTrace — production Firestore security rules
 *
 * Collections (from README / Dart models):
 *   /users/{uid}
 *   /users/{uid}/notifications/{notificationId}   // server-created, owner marks read
 *   /users/{uid}/fcmTokens/{token}                // owner-managed push tokens
 *   /users/{uid}/settings/notifications           // owner-managed notification choices
 *   /reports/{reportId}
 *   /reports/{reportId}/activity/{activityId}
 *   /reports/{reportId}/verifications/{voterUid}   // Member 7 (counted by functions/)
 *   /reports/{reportId}/disputes/{voterUid}        // Member 7 (counted by functions/)
 *
 * Trust model:
 *   - Firebase Auth uid is the only client identity signal.
 *   - Privileged roles (technician, admin) are read from /users/{uid}.role
 *     which clients cannot elevate. Role promotion is Admin SDK / Cloud Functions only.
 *   - verificationCount / disputeCount / disputed status transitions are NOT
 *     client-writable; aggregate via Cloud Functions from verification/dispute docs.
 *
 * Do NOT deploy until AuthService registration stops writing client-chosen roles
 * and role promotion is moved off the client (see update.md / security review).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------
    // Helpers
    // --------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDoc() {
      return get(userPath(request.auth.uid));
    }

    function userExists() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isCitizen() {
      return userExists() && userRole() == 'citizen';
    }

    function isTechnician() {
      return userExists() && userRole() == 'technician';
    }

    function isAdmin() {
      return userExists() && userRole() == 'admin';
    }

    function validRole(role) {
      return role in ['citizen', 'technician', 'admin'];
    }

    function unchanged(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == resource.data[field];
    }

    function onlyChanging(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function reportDoc(reportId) {
      return get(/databases/$(database)/documents/reports/$(reportId));
    }

    function reportExists(reportId) {
      return exists(/databases/$(database)/documents/reports/$(reportId));
    }

    function isAssignedTechnician(report) {
      return isTechnician()
        && report.assignedTechnicianUid == request.auth.uid;
    }

    function validFaultStatus(status) {
      return status in ['pending', 'assigned', 'ongoing', 'completed', 'disputed'];
    }

    function validSeverity(severity) {
      return severity in ['low', 'medium', 'high', 'critical'];
    }

    function validFaultType(faultType) {
      return faultType in [
        'pipeLeak',
        'burstPipe',
        'damagedPipe',
        'roadWaterFlow',
        'lowPressure',
        'waterContamination',
        'other'
      ];
    }

    // --------------------------------------------------------------------------
    // /users/{uid}
    // --------------------------------------------------------------------------

    match /users/{uid} {
      // Profiles are readable by signed-in users (assignment UIs need technician names).
      // Tighten later with a publicProfiles projection if PII must be reduced.
      allow read: if isSignedIn();

      // Self-registration: document id must match Auth uid; role MUST be citizen.
      // Privileged roles cannot be self-assigned from the client.
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role == 'citizen'
        && (!('employeeId' in request.resource.data)
            || request.resource.data.employeeId == null);

      // Self profile edits: never change uid, email, role, or employeeId.
      // Admin may update role / employeeId / assignedArea for workforce management.
      allow update: if (
          isSelf(uid)
          && unchanged('uid')
          && unchanged('email')
          && unchanged('role')
          && unchanged('employeeId')
          && onlyChanging([
            'displayName',
            'phoneNumber',
            'assignedArea',
            'photoUrl',
            'updatedAt',
            'createdAt'
          ])
        )
        || (
          isAdmin()
          && unchanged('uid')
          && unchanged('email')
          && validRole(request.resource.data.role)
          && onlyChanging([
            'displayName',
            'phoneNumber',
            'role',
            'assignedArea',
            'employeeId',
            'photoUrl',
            'updatedAt',
            'createdAt'
          ])
        );

      // Account deletion is an Admin / Auth lifecycle concern, not a client default.
      allow delete: if isAdmin();

      // ------------------------------------------------------------------------
      // /users/{uid}/notifications/{notificationId}
      // ------------------------------------------------------------------------
      match /notifications/{notificationId} {
        allow read: if isSelf(uid) || isAdmin();

        // Clients may only mark their own notifications as read.
        allow update: if isSelf(uid)
          && unchanged('id')
          && unchanged('recipientUid')
          && unchanged('title')
          && unchanged('body')
          && unchanged('reportId')
          && unchanged('type')
          && unchanged('createdAt')
          && onlyChanging(['isRead'])
          && request.resource.data.isRead is bool;

        // Notifications are created ONLY by trusted backend code (Cloud
        // Functions / Admin SDK, which bypass these rules). No client - not
        // even an admin - may create one, so a client can never send itself
        // (or anyone else) a notification. See functions/README.md.
        allow create: if false;

        allow delete: if isSelf(uid) || isAdmin();
      }

      // ------------------------------------------------------------------------
      // /users/{uid}/fcmTokens/{token}  - push device tokens (Member 8)
      //
      // The owner registers / refreshes / removes their own device tokens.
      // The document id IS the token. The backend (Admin SDK) reads them to
      // address pushes; clients can only read their own.
      // ------------------------------------------------------------------------
      match /fcmTokens/{token} {
        allow read: if isSelf(uid);

        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.token == token
          && request.resource.data.platform in ['android', 'ios', 'macos']
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isSelf(uid)
          && request.resource.data.token == resource.data.token
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.platform in ['android', 'ios', 'macos']
          && request.resource.data.updatedAt == request.time
          && onlyChanging(['platform', 'updatedAt']);

        allow delete: if isSelf(uid);
      }

      // ------------------------------------------------------------------------
      // /users/{uid}/settings/notifications  - notification choices (Member 8)
      //
      // The owner mirrors the Settings switches here so the backend can honour
      // them (read with the Admin SDK). Only this one document, only booleans.
      // ------------------------------------------------------------------------
      match /settings/{settingId} {
        allow read: if isSelf(uid);

        allow create, update: if isSelf(uid)
          && settingId == 'notifications'
          && request.resource.data.keys().hasOnly([
            'pushEnabled',
            'reportUpdates',
            'repairVerification',
            'nearbyFaults',
            'updatedAt'
          ])
          && request.resource.data.pushEnabled is bool
          && request.resource.data.repairVerification is bool
          && request.resource.data.nearbyFaults is bool
          && (!('reportUpdates' in request.resource.data)
              || request.resource.data.reportUpdates is bool)
          && request.resource.data.updatedAt == request.time;

        allow delete: if isSelf(uid);
      }
    }

    // --------------------------------------------------------------------------
    // /reports/{reportId}
    // --------------------------------------------------------------------------

    match /reports/{reportId} {
      // Technicians can only read jobs assigned to their own Firebase uid.
      // Citizens read community reports; admins read the full dispatch queue.
      allow read: if isAdmin()
        || isCitizen()
        || isAssignedTechnician(resource.data);

      // Citizens (or any signed-in user with citizen profile) create pending reports
      // about themselves only. Assignment / verification counters start empty.
      allow create: if isSignedIn()
        && userExists()
        && request.resource.data.reportId == reportId
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validFaultType(request.resource.data.faultType)
        && validSeverity(request.resource.data.severity)
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.description is string
        && request.resource.data.verificationCount == 0
        && request.resource.data.disputeCount == 0
        && (
             !('assignedTechnicianUid' in request.resource.data)
             || request.resource.data.assignedTechnicianUid == null
           )
        && (
             !('afterImageUrl' in request.resource.data)
             || request.resource.data.afterImageUrl == null
           );

      allow update: if isSignedIn() && (
        citizenOwnsPendingReportUpdate()
        || technicianAssignedJobUpdate()
        || adminReportUpdate()
      );

      allow delete: if isAdmin();

      // ---- Role-specific update predicates (report match scope) ----

      function citizenOwnsPendingReportUpdate() {
        return isCitizen()
          && resource.data.reporterUid == request.auth.uid
          && resource.data.status == 'pending'
          && unchanged('reporterUid')
          && unchanged('reporterName')
          && unchanged('reportId')
          && unchanged('createdAt')
          && unchanged('assignedTechnicianUid')
          && unchanged('assignedTechnicianName')
          && unchanged('assignedAt')
          && unchanged('verificationCount')
          && unchanged('disputeCount')
          && unchanged('afterImageUrl')
          && request.resource.data.status == 'pending'
          && onlyChanging([
            'faultType',
            'description',
            'severity',
            'latitude',
            'longitude',
            'address',
            'beforeImageUrl',
            'assignedArea',
            'isEmergency',
            'updatedAt',
            'status'
          ]);
      }

      function technicianAssignedJobUpdate() {
        return isAssignedTechnician(resource.data)
          && unchanged('reporterUid')
          && unchanged('reporterName')
          && unchanged('reportId')
          && unchanged('createdAt')
          && unchanged('assignedTechnicianUid')
          && unchanged('assignedTechnicianName')
          && unchanged('verificationCount')
          && unchanged('disputeCount')
          && unchanged('beforeImageUrl')
          && unchanged('latitude')
          && unchanged('longitude')
          && (
            (
              resource.data.status == 'assigned'
              && request.resource.data.status == 'ongoing'
            )
            || (
              resource.data.status == 'ongoing'
              && request.resource.data.status == 'ongoing'
            )
            || (
              resource.data.status == 'ongoing'
              && request.resource.data.status == 'completed'
              && request.resource.data.afterImageUrl is string
              && request.resource.data.afterImageUrl.size() > 0
            )
          )
          && onlyChanging([
            'status',
            'afterImageUrl',
            'repairNotes',
            'updatedAt'
          ]);
      }

      function adminReportUpdate() {
        return isAdmin()
          && unchanged('reporterUid')
          && unchanged('reportId')
          && unchanged('createdAt')
          && validFaultStatus(request.resource.data.status)
          && validSeverity(request.resource.data.severity)
          && (
            request.resource.data.status == resource.data.status
            || (
              resource.data.status in ['pending', 'disputed']
              && request.resource.data.status == 'assigned'
            )
          )
          // Counters still not directly forged by admin clients in bulk;
          // admins may set disputed/completed via workflow, but counts stay
          // function-owned unless explicitly included by a later admin tool.
          && unchanged('verificationCount')
          && unchanged('disputeCount')
          && onlyChanging([
            'status',
            'severity',
            'assignedTechnicianUid',
            'assignedTechnicianName',
            'assignedAt',
            'updatedAt',
            'repairNotes'
          ]);
      }

      // ------------------------------------------------------------------------
      // Activity timeline (append-mostly audit trail)
      // ------------------------------------------------------------------------
      match /activity/{activityId} {
        // Same audience as the parent report: admins, citizens, and the
        // technician assigned to it - so history cannot leak a report the
        // reader could not open.
        allow read: if isAdmin()
          || isCitizen()
          || isAssignedTechnician(reportDoc(reportId).data);

        // Actors may append a timeline event for actions they are allowed to take.
        allow create: if isSignedIn()
          && request.resource.data.reportId == reportId
          && validFaultStatus(request.resource.data.status)
          && (
            isAdmin()
            || (
              isAssignedTechnician(reportDoc(reportId).data)
              && request.resource.data.actorRole == 'Technician'
            )
            || (
              isCitizen()
              && reportDoc(reportId).data.reporterUid == request.auth.uid
              && request.resource.data.actorRole == 'Citizen'
              && request.resource.data.status == 'pending'
            )
          );

        allow update, delete: if false;
      }

      // ------------------------------------------------------------------------
      // Community verification — one vote document per citizen uid
      // Counters / status flips must be applied by Cloud Functions (Admin SDK).
      // ------------------------------------------------------------------------
      match /verifications/{voterUid} {
        allow read: if isSignedIn();

        allow create: if isCitizen()
          && voterUid == request.auth.uid
          && reportExists(reportId)
          && reportDoc(reportId).data.status == 'completed'
          && request.resource.data.keys().hasOnly([
            'voterUid',
            'voterName',
            'reportId',
            'createdAt',
            'note'
          ])
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.reportId == reportId
          && (!('voterName' in request.resource.data)
              || request.resource.data.voterName is string);

        // counted / countedAs / rejected are written by the
        // onVerificationCreated Cloud Function (Admin SDK); clients cannot.

        allow update, delete: if false;
      }

      // ------------------------------------------------------------------------
      // Community disputes — one dispute document per citizen uid
      // Counting the dispute and the auto-reopen to disputed are performed by the
      // onDisputeCreated Cloud Function (Admin SDK), never by clients.
      // ------------------------------------------------------------------------
      match /disputes/{voterUid} {
        allow read: if isSignedIn();

        allow create: if isCitizen()
          && voterUid == request.auth.uid
          && reportExists(reportId)
          && reportDoc(reportId).data.status in ['completed', 'disputed']
          && request.resource.data.keys().hasOnly([
            'voterUid',
            'voterName',
            'reportId',
            'reason',
            'evidenceImageUrl',
            'createdAt'
          ])
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.reportId == reportId
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 2000
          && (!('voterName' in request.resource.data)
              || request.resource.data.voterName is string)
          && (!('evidenceImageUrl' in request.resource.data)
              || request.resource.data.evidenceImageUrl is string);

        allow update, delete: if isAdmin();
      }
    }

    // Deny anything not explicitly matched.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
